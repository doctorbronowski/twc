{
  "name": "twc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,green \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "db:setup": "node --env-file-if-exists=.env.local --import tsx server/setupDatabase.ts",
    "build": "tsc -b && vite build",
    "start": "node app.js",
    "lint": "biome check .",
    "test": "node --import tsx --test server/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
